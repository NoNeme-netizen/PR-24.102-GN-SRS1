<Window x:Class="пavrilov_rul.pages.Window5"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача 5" 
        Height="500" 
        Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Задача 5: Сортировка двумерного массива" 
                   FontSize="22" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" 
                   Text="Сгенерировать массив размером M столбцов и N строк, содержащий числа от -10 до 10. Отобразить его пользователю. Отсортировать элементы в нем по возрастанию и по убыванию. Вывести результаты сортировки в двух таблицах. Найти максимальный и минимальный элементы массива."
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Строки (N):" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
            <TextBox x:Name="txtRows" Width="60" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
            <TextBlock Text="Столбцы (M):" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
            <TextBox x:Name="txtCols" Width="60" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
            <Button x:Name="btnGenerateTask5" 
                    Content="Сгенерировать" 
                    Width="130" 
                    Height="30"
                    FontSize="14"
                    Click="btnGenerateTask5_Click"/>
            <Button x:Name="btnCalculateTask5" 
                    Content="Отсортировать" 
                    Width="130" 
                    Height="30"
                    Margin="10,0,0,0"
                    FontSize="14"
                    Click="btnCalculateTask5_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3" 
                   Text="Результат:" 
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,10,0,5"/>

        <TextBox x:Name="txtResultTask5" 
                 Grid.Row="3"
                 Margin="0,30,0,0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="14"/>

        <Button x:Name="btnBackToMain5" 
                Grid.Row="4"
                Content="Назад в меню" 
                Width="150" 
                Height="35"
                HorizontalAlignment="Right"
                FontSize="14"
                Click="btnBackToMain_Click"/>
    </Grid>
</Window>
