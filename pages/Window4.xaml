<Window x:Class="пavrilov_rul.pages.Window4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача 4" 
        Height="500" 
        Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Задача 4: Перестановка в одномерном массиве" 
                   FontSize="22" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" 
                   Text="Поменять местами максимальный по модулю отрицательный элемент и минимальный положительный. Тестовый массив: 4 5 6 7 -12 -3 4 -5 -7 2"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Введите массив (через пробел):" 
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       FontSize="14"/>
            <TextBox x:Name="txtInputArrayTask4" 
                     Width="300" 
                     Height="30"
                     VerticalContentAlignment="Center"
                     FontSize="14"/>
            <Button x:Name="btnCalculateTask4" 
                    Content="Вычислить" 
                    Width="120" 
                    Height="30"
                    Margin="10,0,0,0"
                    FontSize="14"
                    Click="btnCalculateTask4_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3" 
                   Text="Результат:" 
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,10,0,5"/>

        <TextBox x:Name="txtResultTask4" 
                 Grid.Row="3"
                 Margin="0,30,0,0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="14"/>

        <Button x:Name="btnBackToMain4" 
                Grid.Row="4"
                Content="Назад в меню" 
                Width="150" 
                Height="35"
                HorizontalAlignment="Right"
                FontSize="14"
                Click="btnBackToMain_Click"/>
    </Grid>
</Window>
