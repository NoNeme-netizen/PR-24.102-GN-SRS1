<Window x:Class="пavrilov_rul.pages.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача 2" 
        Height="450" 
        Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Задача 2" 
                   FontSize="22" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" 
                   Text="Дана строка-предложение, содержащая избыточные пробелы. Преобразовать ее так, чтобы между словами был ровно один пробел."
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Введите строку:" 
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       FontSize="14"/>
            <TextBox x:Name="txtInputString" 
                     Width="350" 
                     Height="30"
                     VerticalContentAlignment="Center"
                     FontSize="14"/>
        </StackPanel>

        <Button x:Name="btnCalculateTask2" 
                Grid.Row="3"
                Content="Вычислить" 
                Width="150" 
                Height="35"
                HorizontalAlignment="Left"
                FontSize="14"
                Click="btnCalculateTask2_Click"/>

        <TextBlock Grid.Row="4" 
                   Text="Результат:" 
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,10,0,5"/>

        <TextBox x:Name="txtResultTask2" 
                 Grid.Row="4"
                 Margin="0,30,0,0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="14"/>

        <Button x:Name="btnBackToMain2" 
                Grid.Row="5"
                Content="Назад в меню" 
                Width="150" 
                Height="35"
                HorizontalAlignment="Right"
                FontSize="14"
                Click="btnBackToMain2_Click"/>
    </Grid>
</Window>
